#!/bin/bash
# Menu VLESS - by znandev

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RED='\033[1;31m'
NC='\033[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}              ⚙️ MENU VLESS XRAY              ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} Tambah Akun VLESS"
echo -e "${GREEN}[2]${NC} Hapus Akun VLESS"
echo -e "${GREEN}[3]${NC} Cek Login VLESS"
echo -e "${GREEN}[4]${NC} Perpanjang Masa Aktif Akun"
echo -e "${GREEN}[x]${NC} Kembali ke menu utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

read -rp "👉 Pilih opsi: " opt

case $opt in
    1)
        if [ -f /etc/autoscriptvpn/xray/add-vless.sh ]; then
            bash /etc/autoscriptvpn/xray/add-vless.sh
        else
            echo -e "${RED}❌ Script add-vless.sh tidak ditemukan!${NC}"
            sleep 1
            m-vless
        fi
        ;;
    2)
        if [ -f /etc/autoscriptvpn/xray/del-vless.sh ]; then
            bash /etc/autoscriptvpn/xray/del-vless.sh
        else
            echo -e "${RED}❌ Script del-vless.sh tidak ditemukan!${NC}"
            sleep 1
            m-vless
        fi
        ;;
    3)
        if [ -f /etc/autoscriptvpn/xray/cek-vless.sh ]; then
            bash /etc/autoscriptvpn/xray/cek-vless.sh
        else
            echo -e "${RED}❌ Script cek-vless.sh tidak ditemukan!${NC}"
            sleep 1
            m-vless
        fi
        ;;
    4)
        if [ -f /etc/autoscriptvpn/xray/renew-vless.sh ]; then
            bash /etc/autoscriptvpn/xray/renew-vless.sh
        else
            echo -e "${RED}❌ Script renew-vless.sh tidak ditemukan!${NC}"
            sleep 1
            m-vless
        fi
        ;;
    x|X)
        menu
        ;;
    *)
        echo -e "\n${RED}❌ Pilihan salah!${NC}"
        sleep 1
        m-vless
        ;;
esac

