#!/bin/bash
# Menu VMess - by znandev

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RED='\033[1;31m'
NC='\033[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}              ⚙️ MENU VMESS XRAY              ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} Tambah Akun VMess"
echo -e "${GREEN}[2]${NC} Hapus Akun VMess"
echo -e "${GREEN}[3]${NC} Cek Login VMess"
echo -e "${GREEN}[4]${NC} Perpanjang Masa Aktif Akun"
echo -e "${GREEN}[x]${NC} Kembali ke menu utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

read -rp "👉 Pilih opsi: " opt

case $opt in
    1)
        if [ -f /etc/autoscriptvpn/xray/add-vmess.sh ]; then
            bash /etc/autoscriptvpn/xray/add-vmess.sh
        else
            echo -e "${RED}❌ Script add-vmess.sh tidak ditemukan!${NC}"
            sleep 1
            m-vmess
        fi
        ;;
    2)
        if [ -f /etc/autoscriptvpn/xray/del-vmess.sh ]; then
            bash /etc/autoscriptvpn/xray/del-vmess.sh
        else
            echo -e "${RED}❌ Script del-vmess.sh tidak ditemukan!${NC}"
            sleep 1
            m-vmess
        fi
        ;;
    3)
        if [ -f /etc/autoscriptvpn/xray/cek-vmess.sh ]; then
            bash /etc/autoscriptvpn/xray/cek-vmess.sh
        else
            echo -e "${RED}❌ Script cek-vmess.sh tidak ditemukan!${NC}"
            sleep 1
            m-vmess
        fi
        ;;
    4)
        if [ -f /etc/autoscriptvpn/xray/renew-vmess.sh ]; then
            bash /etc/autoscriptvpn/xray/renew-vmess.sh
        else
            echo -e "${RED}❌ Script renew-vmess.sh tidak ditemukan!${NC}"
            sleep 1
            m-vmess
        fi
        ;;
    x|X)
        menu
        ;;
    *)
        echo -e "\n${RED}❌ Pilihan salah!${NC}"
        sleep 1
        m-vmess
        ;;
es:

