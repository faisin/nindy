#!/bin/bash
# Menu Trojan - by znandev

# Warna
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RED='\033[1;31m'
NC='\033[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}             ⚙️  MENU TROJAN XRAY              ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} Tambah Akun Trojan"
echo -e "${GREEN}[2]${NC} Hapus Akun Trojan"
echo -e "${GREEN}[3]${NC} Cek Login Trojan"
echo -e "${GREEN}[4]${NC} Perpanjang Masa Aktif Akun"
echo -e "${GREEN}[x]${NC} Kembali ke menu utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

read -rp "👉 Pilih opsi: " opt

case $opt in
    1) 
        if [ -f /etc/autoscriptvpn/xray/add-trojan.sh ]; then
            bash /etc/autoscriptvpn/xray/add-trojan.sh
        else
            echo -e "${RED}❌ Script add-trojan.sh tidak ditemukan!${NC}"
            sleep 1
            m-trojan
        fi
        ;;
    2) 
        if [ -f /etc/autoscriptvpn/xray/del-trojan.sh ]; then
            bash /etc/autoscriptvpn/xray/del-trojan.sh
        else
            echo -e "${RED}❌ Script del-trojan.sh tidak ditemukan!${NC}"
            sleep 1
            m-trojan
        fi
        ;;
    3)
        if [ -f /etc/autoscriptvpn/xray/cek-trojan.sh ]; then
            bash /etc/autoscriptvpn/xray/cek-trojan.sh
        else
            echo -e "${RED}❌ Script cek-trojan.sh tidak ditemukan!${NC}"
            sleep 1
            m-trojan
        fi
        ;;
    4) 
        if [ -f /etc/autoscriptvpn/xray/renew-trojan.sh ]; then
            bash /etc/autoscriptvpn/xray/renew-trojan.sh
        else
            echo -e "${RED}❌ Script renew-trojan.sh tidak ditemukan!${NC}"
            sleep 1
            m-trojan
        fi
        ;;
    x|X) 
        menu 
        ;;
    *) 
        echo -e "\n${RED}❌ Pilihan salah!${NC}"
        sleep 1
        m-trojan
        ;;
esac

