#!/bin/bash
# Menu WireGuard - by znandev

# Warna
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RED='\033[1;31m'
NC='\033[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}             ⚙️ MENU WIREGUARD VPN             ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} Tambah Akun WireGuard"
echo -e "${GREEN}[2]${NC} Hapus Akun WireGuard"
echo -e "${GREEN}[3]${NC} Lihat Konfigurasi Akun"
echo -e "${GREEN}[4]${NC} Cek Status WireGuard"
echo -e "${GREEN}[5]${NC} Restart WireGuard"
echo -e "${GREEN}[x]${NC} Kembali ke menu utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
read -rp "👉 Pilih opsi: " opt

case $opt in
    1)
        clear
        if [ -f /etc/autoscriptvpn/wg/wg-add.sh ]; then
            bash /etc/autoscriptvpn/wg/wg-add.sh
        else
            echo -e "${RED}❌ Script wg-add.sh tidak ditemukan!${NC}"
            sleep 1
            m-wg
        fi
        ;;
    2)
        clear
        if [ -f /etc/autoscriptvpn/wg/wg-del.sh ]; then
            bash /etc/autoscriptvpn/wg/wg-del.sh
        else
            echo -e "${RED}❌ Script wg-del.sh tidak ditemukan!${NC}"
            sleep 1
            m-wg
        fi
        ;;
    3)
        clear
        if [ -f /etc/autoscriptvpn/wg/wg-show.sh ]; then
            bash /etc/autoscriptvpn/wg/wg-show.sh
        else
            echo -e "${RED}❌ Script wg-show.sh tidak ditemukan!${NC}"
            sleep 1
            m-wg
        fi
        ;;
    4)
        clear
        wg show
        echo ""
        read -n 1 -s -r -p "Tekan apa saja untuk kembali ke menu..."
        m-wg
        ;;
    5)
        clear
        systemctl restart wg-quick@wg0
        echo -e "\n${GREEN}✅ WireGuard berhasil direstart!${NC}\n"
        sleep 1.5
        m-wg
        ;;
    x|X)
        menu
        ;;
    *)
        echo -e "\n${RED}❌ Pilihan salah!${NC}"
        sleep 1
        m-wg
        ;;
esac

