#!/bin/bash
# Menu Tools - by znandev

# Warna
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}                 ⚙️ MENU TOOLS                  ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} Backup & Restore Config"
echo -e "${GREEN}[2]${NC} Speedtest VPS"
echo -e "${GREEN}[3]${NC} Ganti Domain XRAY"
echo -e "${GREEN}[4]${NC} Cek status layanan aktif"
echo -e "${GREEN}[x]${NC} Kembali ke menu utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
read -rp "👉 Pilih opsi: " opt

case $opt in
    1) 
        if [ -f /etc/autoscriptvpn/tools/backup.sh ]; then
            bash /etc/autoscriptvpn/tools/backup.sh
        else
            echo -e "${RED}❌ Script backup.sh tidak ditemukan!${NC}"
            sleep 1
            tools-menu
        fi
        ;;
    2) 
        if [ -f /etc/autoscriptvpn/tools/speedtest.sh ]; then
            bash /etc/autoscriptvpn/tools/speedtest.sh
        else
            echo -e "${RED}❌ Script speedtest.sh tidak ditemukan!${NC}"
            sleep 1
            tools-menu
        fi
        ;;
    3) 
        if [ -f /etc/autoscriptvpn/tools/domain.sh ]; then
            bash /etc/autoscriptvpn/tools/domain.sh
        else
            echo -e "${RED}❌ Script domain.sh tidak ditemukan!${NC}"
            sleep 1
            tools-menu
        fi
        ;;
    4) 
        if [ -f /etc/autoscriptvpn/tools/running.sh ]; then
            bash /etc/autoscriptvpn/tools/running.sh
        else
            echo -e "${RED}❌ Script running.sh tidak ditemukan!${NC}"
            sleep 1
            tools-menu
        fi
        ;;
    x|X) 
        menu 
        ;;
    *) 
        echo -e "\n${RED}❌ Pilihan salah!${NC}"
        sleep 1
        tools-menu
        ;;
esac

