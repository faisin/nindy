#!/bin/bash
# ==========================================
# Menu Manajemen UDP Zivpn
# ==========================================

clear
echo -e "\033[0;36m==========================================\033[0m"
echo -e "\033[0;32m            MANAJEMEN UDP ZIVPN           \033[0m"
echo -e "\033[0;36m==========================================\033[0m"
echo -e " [1] \033[0;33mBuat Akun Trial Zivpn (trial-zivpn.sh)\033[0m"
echo -e " [2] \033[0;33mBuat Akun Zivpn Permanen (add-zivpn.sh)\033[0m"
echo -e " [3] \033[0;33mCek Layanan & Monitor Zivpn\033[0m"
echo -e " [x] \033[0;31mKembali ke Menu Utama\033[0m"
echo -e "\033[0;36m==========================================\033[0m"
read -p " Pilih opsi [1-3 atau x]: " udp_opt

case $udp_opt in
    1)
        if [ -f "./udp/trial-zivpn.sh" ]; then
            bash ./udp/trial-zivpn.sh
        else
            echo -e "\033[0;31m[X] Skrip trial-zivpn.sh belum tersedia.\033[0m"
            sleep 1
        fi
        ;;
    2)
        if [ -f "./udp/add-zivpn.sh" ]; then
            bash ./udp/add-zivpn.sh
        else
            echo -e "\033[0;31m[X] Skrip add-zivpn.sh belum tersedia.\033[0m"
            sleep 1
        fi
        ;;
    3)
        if [ -f "./udp/monitor-zivpn.sh" ]; then
            bash ./udp/monitor-zivpn.sh
        else
            systemctl status udp-custom --no-pager
            read -p "Tekan [Enter] untuk kembali..."
        fi
        ;;
    x|X)
        exit 0
        ;;
    *)
        echo -e "\033[0;31mPilihan tidak valid!\033[0m"
        sleep 1
        ;;
esac
