#!/bin/bash
# ==========================================
# Menu Manajemen SSH & Dropbear
# ==========================================

clear
echo -e "\033[0;36m==========================================\033[0m"
echo -e "\033[0;32m            MANAJEMEN AKUN SSH            \033[0m"
echo -e "\033[0;36m==========================================\033[0m"
echo -e " [1] \033[0;33mBuat Akun SSH & Dropbear (addssh.sh)\033[0m"
echo -e " [2] \033[0;33mCek User Login SSH\033[0m"
echo -e " [3] \033[0;33mHapus Akun SSH\033[0m"
echo -e " [x] \033[0;31mKembali ke Menu Utama\033[0m"
echo -e "\033[0;36m==========================================\033[0m"
read -p " Pilih opsi [1-3 atau x]: " ssh_opt

case $ssh_opt in
    1)
        if [ -f "./ssh/addssh.sh" ]; then
            bash ./ssh/addssh.sh
        else
            echo -e "\033[0;31m[X] Skrip addssh.sh belum tersedia.\033[0m"
            sleep 1
        fi
        ;;
    2)
        echo -e "\033[0;32m--- Daftar User yang Sedang Login ---\033[0m"
        who
        read -p "Tekan [Enter] untuk kembali..."
        ;;
    3)
        echo -e "\033[0;33mFitur hapus akun akan segera dijalankan...\033[0m"
        sleep 1
        ;;
    x|X)
        exit 0
        ;;
    *)
        echo -e "\033[0;31mPilihan tidak valid!\033[0m"
        sleep 1
        ;;
esac
