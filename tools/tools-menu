#!/bin/bash
# ==========================================
# Menu Utilitas & Tools
# ==========================================

clear
echo -e "\033[0;36m==========================================\033[0m"
echo -e "\033[0;32m              MENU TOOLS VPS              \033[0m"
echo -e "\033[0;36m==========================================\033[0m"
echo -e " [1] \033[0;33mCek Status Layanan & Port (running.sh)\033[0m"
echo -e " [2] \033[0;33mBackup Konfigurasi Sistem (backup.sh)\033[0m"
echo -e " [3] \033[0;33mUbah / Ganti Domain VPS (domain.sh)\033[0m"
echo -e " [4] \033[0;33mTes Kecepatan Internet (speedtest.sh)\033[0m"
echo -e " [x] \033[0;31mKembali ke Menu Utama\033[0m"
echo -e "\033[0;36m==========================================\033[0m"
read -p " Pilih opsi [1-4 atau x]: " tool_opt

case $tool_opt in
    1) bash ./tools/running.sh ;;
    2) bash ./tools/backup.sh ;;
    3) 
        if [ -f "./tools/domain.sh" ]; then bash ./tools/domain.sh; 
        else echo -e "\033[0;31m[X] Script domain.sh belum ada.\033[0m"; sleep 1; fi 
        ;;
    4) 
        if [ -f "./tools/speedtest.sh" ]; then bash ./tools/speedtest.sh; 
        else speedtest; read -p "Tekan [Enter]..."; fi 
        ;;
    x|X) exit 0 ;;
    *) echo -e "\033[0;31mPilihan tidak valid!\033[0m"; sleep 1 ;;
esac
