#!/bin/bash
# Menu Shadowsocks WS - by znandev

# Warna
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RED='\033[1;31m'
NC='\033[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}         ⚙️ MENU SHADOWSOCKS WEBSOCKET         ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} Tambah Akun Shadowsocks WS"
echo -e "${GREEN}[2]${NC} Hapus Akun Shadowsocks WS"
echo -e "${GREEN}[3]${NC} Cek Login Shadowsocks WS"
echo -e "${GREEN}[4]${NC} Perpanjang Masa Aktif Akun"
echo -e "${GREEN}[x]${NC} Kembali ke menu utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
read -rp "👉 Pilih opsi: " opt

case $opt in
    1) 
        if [ -f /etc/autoscriptvpn/xray/add-ssws.sh ]; then
            bash /etc/autoscriptvpn/xray/add-ssws.sh
        else
            m-ssws
        fi
        ;;
    2) 
        if [ -f /etc/autoscriptvpn/xray/del-ssws.sh ]; then
            bash /etc/autoscriptvpn/xray/del-ssws.sh
        else
            m-ssws
        fi
        ;;
    3) 
        if [ -f /etc/autoscriptvpn/xray/cek-ssws.sh ]; then
            bash /etc/autoscriptvpn/xray/cek-ssws.sh
        else
            m-ssws
        fi
        ;;
    4) 
        if [ -f /etc/autoscriptvpn/xray/renew-ssws.sh ]; then
            bash /etc/autoscriptvpn/xray/renew-ssws.sh
        else
            m-ssws
        fi
        ;;
    x|X) 
        menu 
        ;;
    *)
        echo -e "\n${RED}❌ Pilihan salah!${NC}"
        sleep 1
        m-ssws
        ;;
esac

