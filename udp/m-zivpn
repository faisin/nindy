#!/bin/bash
# ==========================================
# MENU UDP ZIVPN - by znandev
# ==========================================

clear

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# ==============================
# STATUS
# ==============================
ZIVPN=$(systemctl is-active zivpn 2>/dev/null)

if [[ $ZIVPN == "active" ]]; then
    ZIVPN="${GREEN}🟢 ONLINE${NC}"
else
    ZIVPN="${RED}🔴 OFFLINE${NC}"
fi

# ==============================
# USER COUNT
# ==============================
TOTAL=$(grep -vc '^$' /etc/zivpn/users.db 2>/dev/null || echo 0)

# ==============================
# DOMAIN
# ==============================
DOMAIN=$(cat /etc/xray/domain 2>/dev/null)

if [[ -z "$DOMAIN" ]]; then
    DOMAIN=$(curl -s --max-time 5 ipv4.icanhazip.com || curl -s --max-time 5 ifconfig.me)
fi

# ==============================
# HEADER
# ==============================
echo -e "${CYAN}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${NC}"
echo -e "${CYAN}┃${WHITE}            ⚡ UDP ZIVPN MENU ⚡            ${CYAN}┃${NC}"
echo -e "${CYAN}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${NC}"

# ==============================
# INFO
# ==============================
echo -e "${YELLOW}┌──────────────── INFO ──────────────────────┐${NC}"

printf " ${WHITE}🌍 DOMAIN${NC}      : %-25s\n" "$DOMAIN"
printf " ${WHITE}⚡ STATUS${NC}      : %-25b\n" "$ZIVPN"
printf " ${WHITE}👤 TOTAL USER${NC}  : %-25s\n" "$TOTAL"
printf " ${WHITE}🔌 UDP PORT${NC}    : %-25s\n" "5667"

echo -e "${YELLOW}└────────────────────────────────────────────┘${NC}"

# ==============================
# MENU
# ==============================
echo -e "${GREEN}┌──────────────── MENU ──────────────────────┐${NC}"

echo -e " [1] ➕ Add User        [5] 👥 Check Member"
echo -e " [2] 🎁 Trial User      [6] 📡 Online User"
echo -e " [3] ♻️ Renew User      [7] 🔄 Restart Service"
echo -e " [4] ❌ Delete User     [8] 📜 Check Log"
echo -e "                        [x] ⬅ BACK"

echo -e "${GREEN}└────────────────────────────────────────────┘${NC}"

echo ""
read -rp "Select Menu : " opt

case $opt in
    1)
        if [ -f /etc/autoscriptvpn/udp/add-zivpn.sh ]; then
            bash /etc/autoscriptvpn/udp/add-zivpn.sh
        else
            echo -e "${RED}❌ Script add-zivpn.sh tidak ditemukan!${NC}"
            sleep 1
            m-zivpn
        fi
        ;;
    2)
        if [ -f /etc/autoscriptvpn/udp/trial-zivpn.sh ]; then
            bash /etc/autoscriptvpn/udp/trial-zivpn.sh
        else
            echo -e "${RED}❌ Script trial-zivpn.sh tidak ditemukan!${NC}"
            sleep 1
            m-zivpn
        fi
        ;;
    3)
        if [ -f /etc/autoscriptvpn/udp/renew-zivpn.sh ]; then
            bash /etc/autoscriptvpn/udp/renew-zivpn.sh
        else
            echo -e "${RED}❌ Script renew-zivpn.sh tidak ditemukan!${NC}"
            sleep 1
            m-zivpn
        fi
        ;;
    4)
        if [ -f /etc/autoscriptvpn/udp/del-zivpn.sh ]; then
            bash /etc/autoscriptvpn/udp/del-zivpn.sh
        else
            echo -e "${RED}❌ Script del-zivpn.sh tidak ditemukan!${NC}"
            sleep 1
            m-zivpn
        fi
        ;;
    5)
        if [ -f /etc/autoscriptvpn/udp/cek-zivpn.sh ]; then
            bash /etc/autoscriptvpn/udp/cek-zivpn.sh
        else
            echo -e "${RED}❌ Script cek-zivpn.sh tidak ditemukan!${NC}"
            sleep 1
            m-zivpn
        fi
        ;;
    6)
        if [ -f /etc/autoscriptvpn/udp/monitor-zivpn.sh ]; then
            bash /etc/autoscriptvpn/udp/monitor-zivpn.sh
        else
            echo -e "${RED}❌ Script monitor-zivpn.sh tidak ditemukan!${NC}"
            sleep 1
            m-zivpn
        fi
        ;;
    7)
        systemctl restart zivpn
        echo ""
        echo -e "${GREEN}✅ ZIVPN service restarted successfully!${NC}"
        sleep 1.5
        m-zivpn
        ;;
    8)
        clear
        echo -e "${CYAN}📜 ZIVPN Service Logs:${NC}"
        echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        journalctl -u zivpn --no-pager -n 20
        echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        read -n 1 -s -r -p "Tekan apa saja untuk kembali ke menu..."
        m-zivpn
        ;;
    x|X)
        menu
        ;;
    *)
        echo -e "\n${RED}❌ Pilihan salah!${NC}"
        sleep 1
        m-zivpn
        ;;
esac

